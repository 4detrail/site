rules_version = '2';
// Storage kuralları: haber görselleri herkes tarafından okunabilir, yalnızca yönetici yükler.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        'yigittr1922@gmail.com',
        'firecrostnetwork@gmail.com',
        'hexagesgames@gmail.com',
        'wither3169999@gmail.com'
      ];
    }
    match /game-news/{gameId}/{file} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /dekontlar/{file} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
